{
  "notes": "Selectors for facebook.com/messages (personal account). Prefer ARIA roles/labels; each list is tried in order. Edit here, not in code. Verified status is recorded in 'verified'.",
  "verified": "2026-10-18 ~07:45 ET on the owner's inbox: thread list (incl. e2ee threads), [aria-roledescription=message] rows with data-message-id, 'You sent' headings",
  "inbox_url": "https://www.facebook.com/messages/",
  "thread_url": "https://www.facebook.com/messages/t/{thread_id}/",
  "login_url": "https://www.facebook.com/login",
  "thread_link": [
    "a[href*='/messages/t/'], a[href*='/messages/e2ee/t/']",
    "a[href^='/t/']"
  ],
  "thread_id_re": "/(?:messages/(?:e2ee/)?)?t/([0-9A-Za-z_.-]+)",
  "thread_list_root": [
    "[role='navigation'] [aria-label='Chats']",
    "[aria-label='Chats']",
    "[role='navigation']",
    "body"
  ],
  "conversation_root": [
    "[role='main'] [aria-label^='Messages in conversation']",
    "[aria-label^='Messages in conversation']",
    "[role='main'] [role='grid']",
    "[role='main']"
  ],
  "message_row": [
    "[aria-roledescription='message']",
    "[role='article'][data-message-id], [data-message-id]",
    "[role='row']",
    "[role='gridcell']"
  ],
  "message_text": [
    "div[dir='auto']"
  ],
  "outgoing_markers": [
    "You sent",
    "You:"
  ],
  "composer": [
    "[role='main'] [role='textbox'][contenteditable='true'][aria-label*='essage' i]",
    "[role='main'] [role='textbox'][contenteditable='true']",
    "[role='textbox'][contenteditable='true']"
  ],
  "login_wall_url": [
    "/login",
    "/checkpoint",
    "two_step_verification",
    "/recover",
    "captcha"
  ],
  "login_wall_dom": [
    "input[name='pass']",
    "form#login_form",
    "iframe[src*='captcha']",
    "[id*='captcha' i]"
  ],
  "login_wall_text": [
    "Confirm you're human",
    "security check",
    "Enter the characters you see",
    "Log in to Facebook",
    "Log into Facebook",
    "We suspended your account",
    "Confirm your identity"
  ],
  "system_text_patterns": [
    "is waiting for your response",
    "waiting for your response",
    "^You (can now|are now) ",
    "^You started this chat",
    "reacted .* to your message",
    "^You reacted",
    "^.{0,60} reacted ",
    "^(Seen|Delivered|Sent)( by .*)?$",
    "^Enter$",
    "^(Today|Yesterday|Mon|Tue|Wed|Thu|Fri|Sat|Sun)[a-z]*( at)? ?\\d{1,2}:\\d{2}( ?[AP]M)?$",
    "^\\d{1,2}:\\d{2}( ?[AP]M)?$",
    "^[A-Z][a-z]{2} \\d{1,2},? (\\d{4},? )?(at )?\\d{1,2}:\\d{2}( ?[AP]M)?$",
    "^\\d{1,2}/\\d{1,2}/\\d{2,4},? \\d{1,2}:\\d{2}( ?[AP]M)?$",
    "marked the listing as",
    "changed the listing",
    "^View (listing|seller profile|buyer profile)$",
    "^Messages and calls are secured",
    "end-to-end encrypted",
    "^You (sent|unsent) a",
    "unsent a message",
    "^You named the group",
    "^Rate (buyer|seller)",
    "^See details$",
    "^Mark as (sold|available|pending)",
    "^Send a quick response"
  ]
}