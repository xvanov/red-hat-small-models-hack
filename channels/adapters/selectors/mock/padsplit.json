{
  "platform": "padsplit",
  "target": "mock",
  "verified": true,
  "notes": "Written against the mock's v1 layout. Switching the mock to v2 breaks most of these on purpose; the repair loop rewrites them.",
  "start_url": "{base}/padsplit/create",
  "inbox_url": "{base}/padsplit/inbox",
  "thread_url": "{base}/padsplit/inbox/{id}",
  "login_wall": "#login-wall",
  "validation_error": ".form-error",
  "after_submit": "posted",
  "elements": {
    "address": {
      "selector": "[data-testid=\"address-input\"]",
      "action": "fill",
      "description": "Property address (text field) on step 'Property'"
    },
    "room_name": {
      "selector": "[data-testid=\"room-name-input\"]",
      "action": "fill",
      "description": "Room name (text field) on step 'Property'"
    },
    "next_1": {
      "selector": "[data-testid=\"next-btn\"]",
      "action": "click",
      "description": "'Next' button that advances from step 'Property' to the next step"
    },
    "weekly_price": {
      "selector": "[data-testid=\"weekly-price-input\"]",
      "action": "fill",
      "description": "Weekly price (number field) on step 'Room details'"
    },
    "room_size": {
      "selector": "[data-testid=\"room-size-input\"]",
      "action": "select",
      "description": "Room size (select field) on step 'Room details'"
    },
    "private_bath": {
      "selector": "[data-testid=\"private-bath-input\"]",
      "action": "check",
      "description": "Private bathroom (checkbox field) on step 'Room details'"
    },
    "furnished": {
      "selector": "[data-testid=\"furnished-input\"]",
      "action": "check",
      "description": "Furnished (checkbox field) on step 'Room details'"
    },
    "available_date": {
      "selector": "[data-testid=\"available-date-input\"]",
      "action": "fill",
      "description": "Available date (date field) on step 'Room details'"
    },
    "next_2": {
      "selector": "[data-testid=\"next-btn\"]",
      "action": "click",
      "description": "'Next' button that advances from step 'Room details' to the next step"
    },
    "description": {
      "selector": "[data-testid=\"description-input\"]",
      "action": "fill",
      "description": "Room description (textarea field) on step 'Description'"
    },
    "next_3": {
      "selector": "[data-testid=\"next-btn\"]",
      "action": "click",
      "description": "'Next' button that advances from step 'Description' to the next step"
    },
    "photos": {
      "selector": "[data-testid=\"photos-input\"]",
      "action": "upload",
      "description": "Upload photos (photo upload file input) on step 'Photos'"
    },
    "next_4": {
      "selector": "[data-testid=\"next-btn\"]",
      "action": "click",
      "description": "'Next' button that advances from step 'Photos' to the next step"
    },
    "publish": {
      "selector": "[data-testid=\"submit-review\"]",
      "action": "submit",
      "description": "final 'Submit for review' button on the review step that makes the listing public (NEVER clicked on live sites)"
    },
    "posted": {
      "selector": "#posted",
      "action": "exists",
      "description": "confirmation box shown after publishing, carries data-listing-id"
    },
    "thread_row": {
      "selector": ".thread-row",
      "action": "rows",
      "attr": "data-thread-id",
      "attr_pattern": "^t\\d+$",
      "name_selector": ".who",
      "unanswered_attr": "data-unanswered",
      "unanswered_true": "1",
      "description": "one row per conversation in the inbox list; an attribute on it holds the thread id (t1234)"
    },
    "message": {
      "selector": "#messages .msg",
      "action": "rows",
      "attr": "data-message-id",
      "attr_pattern": "^m\\d+$",
      "from_attr": "data-from",
      "from_map": {
        "renter": "renter",
        "operator": "operator"
      },
      "description": "one element per chat message in an open thread; an attribute holds the message id (m1234), another says who wrote it"
    },
    "reply_box": {
      "selector": "textarea[name=\"text\"]",
      "action": "fill",
      "description": "message composer text box in an open thread"
    },
    "send_button": {
      "selector": "#send-btn",
      "action": "click",
      "description": "button that sends the typed reply"
    }
  },
  "flow": [
    {
      "do": "fill",
      "el": "address",
      "value": "address",
      "required": true
    },
    {
      "do": "fill",
      "el": "room_name",
      "value": "room_name",
      "required": true
    },
    {
      "do": "click",
      "el": "next_1"
    },
    {
      "do": "fill",
      "el": "weekly_price",
      "value": "weekly_price",
      "required": true
    },
    {
      "do": "select",
      "el": "room_size",
      "value": "room_size",
      "required": true
    },
    {
      "do": "check",
      "el": "private_bath",
      "value": "private_bath"
    },
    {
      "do": "check",
      "el": "furnished",
      "value": "furnished"
    },
    {
      "do": "fill",
      "el": "available_date",
      "value": "available_date",
      "required": true
    },
    {
      "do": "click",
      "el": "next_2"
    },
    {
      "do": "fill",
      "el": "description",
      "value": "description",
      "required": true
    },
    {
      "do": "click",
      "el": "next_3"
    },
    {
      "do": "upload",
      "el": "photos",
      "value": "photos",
      "required": true
    },
    {
      "do": "click",
      "el": "next_4"
    },
    {
      "do": "stop_before",
      "el": "publish"
    }
  ],
  "changelog": []
}
