{
  "platform": "craigslist",
  "target": "mock",
  "verified": true,
  "notes": "Written against the mock's v1 layout. Switching the mock to v2 breaks most of these on purpose; the repair loop rewrites them.",
  "start_url": "{base}/craigslist/create",
  "inbox_url": "{base}/craigslist/inbox",
  "thread_url": "{base}/craigslist/inbox/{id}",
  "login_wall": "#login-wall",
  "validation_error": ".form-error",
  "after_submit": "posted",
  "elements": {
    "category_rooms": {
      "selector": "input[name=\"id\"][value=\"rooms & shares\"]",
      "action": "check",
      "description": "category (radio option 'rooms & shares') on step 'choose the type of posting'"
    },
    "next_1": {
      "selector": "button[name=\"go\"][value=\"continue\"]",
      "action": "click",
      "description": "'continue' button that advances from step 'choose the type of posting' to the next step"
    },
    "posting_title": {
      "selector": "input[name=\"PostingTitle\"]",
      "action": "fill",
      "description": "posting title (text field) on step 'posting details'"
    },
    "price": {
      "selector": "input[name=\"price\"]",
      "action": "fill",
      "description": "price (number field) on step 'posting details'"
    },
    "area": {
      "selector": "input[name=\"geographic_area\"]",
      "action": "fill",
      "description": "city or neighborhood (text field) on step 'posting details'"
    },
    "postal": {
      "selector": "input[name=\"postal\"]",
      "action": "fill",
      "description": "ZIP code (text field) on step 'posting details'"
    },
    "body": {
      "selector": "textarea[name=\"PostingBody\"]",
      "action": "fill",
      "description": "description (textarea field) on step 'posting details'"
    },
    "available_on": {
      "selector": "input[name=\"moveinDate\"]",
      "action": "fill",
      "description": "available on (date field) on step 'posting details'"
    },
    "private_bath": {
      "selector": "select[name=\"private_bath\"]",
      "action": "select",
      "description": "private bath (select field) on step 'posting details'"
    },
    "email": {
      "selector": "input[name=\"FromEMail\"]",
      "action": "fill",
      "description": "your email address (text field) on step 'posting details'"
    },
    "next_2": {
      "selector": "button[name=\"go\"][value=\"continue\"]",
      "action": "click",
      "description": "'continue' button that advances from step 'posting details' to the next step"
    },
    "photos": {
      "selector": "input[name=\"photos\"]",
      "action": "upload",
      "description": "add images (photo upload file input) on step 'add images'"
    },
    "next_3": {
      "selector": "button[name=\"go\"][value=\"continue\"]",
      "action": "click",
      "description": "'continue' button that advances from step 'add images' to the next step"
    },
    "publish": {
      "selector": "button[name=\"go\"][value=\"publish\"]",
      "action": "submit",
      "description": "final 'publish' button on the review step that makes the listing public (NEVER clicked on live sites)"
    },
    "posted": {
      "selector": "#posted",
      "action": "exists",
      "description": "confirmation box shown after publishing, carries data-listing-id"
    },
    "thread_row": {
      "selector": ".thread-row",
      "action": "rows",
      "attr": "data-thread-id",
      "attr_pattern": "^t\\d+$",
      "name_selector": ".who",
      "unanswered_attr": "data-unanswered",
      "unanswered_true": "1",
      "description": "one row per conversation in the inbox list; an attribute on it holds the thread id (t1234)"
    },
    "message": {
      "selector": "#messages .msg",
      "action": "rows",
      "attr": "data-message-id",
      "attr_pattern": "^m\\d+$",
      "from_attr": "data-from",
      "from_map": {
        "renter": "renter",
        "operator": "operator"
      },
      "description": "one element per chat message in an open thread; an attribute holds the message id (m1234), another says who wrote it"
    },
    "reply_box": {
      "selector": "textarea[name=\"text\"]",
      "action": "fill",
      "description": "message composer text box in an open thread"
    },
    "send_button": {
      "selector": "#send-btn",
      "action": "click",
      "description": "button that sends the typed reply"
    }
  },
  "flow": [
    {
      "do": "check",
      "el": "category_rooms",
      "required": true
    },
    {
      "do": "click",
      "el": "next_1"
    },
    {
      "do": "fill",
      "el": "posting_title",
      "value": "posting_title",
      "required": true
    },
    {
      "do": "fill",
      "el": "price",
      "value": "price",
      "required": true
    },
    {
      "do": "fill",
      "el": "area",
      "value": "area",
      "required": true
    },
    {
      "do": "fill",
      "el": "postal",
      "value": "postal",
      "required": true
    },
    {
      "do": "fill",
      "el": "body",
      "value": "body",
      "required": true
    },
    {
      "do": "fill",
      "el": "available_on",
      "value": "available_date",
      "required": true
    },
    {
      "do": "select",
      "el": "private_bath",
      "value": "private_bath_text"
    },
    {
      "do": "fill",
      "el": "email",
      "value": "email",
      "required": true
    },
    {
      "do": "click",
      "el": "next_2"
    },
    {
      "do": "upload",
      "el": "photos",
      "value": "photos",
      "required": true
    },
    {
      "do": "click",
      "el": "next_3"
    },
    {
      "do": "stop_before",
      "el": "publish"
    }
  ],
  "changelog": []
}
