{
  "platform": "marketplace",
  "target": "live",
  "verified": false,
  "notes": "UNVERIFIED best guess at the real site, written without logging in. Expect the first live run to hit PAGE_CHANGED on some elements; the repair loop (operator model) rewrites them against the real page and logs each change below. The final button is never clicked.",
  "start_url": "https://www.facebook.com/marketplace/create/rental",
  "login_url": "https://www.facebook.com/login",
  "login_wall": "form#login_form, form[action*=\"login\"] input[name=\"pass\"]",
  "validation_error": "[role=\"alert\"]",
  "elements": {
    "photos": {
      "selector": "input[type=\"file\"][accept*=\"image\"]",
      "action": "upload",
      "description": "Add photos (photo upload file input)"
    },
    "home_type": {
      "selector": "role=combobox[name=\"Rental type\"]",
      "action": "choose",
      "description": "Rental type (dropdown: Apartment, House, Room only, Townhouse)"
    },
    "bedrooms": {
      "selector": "role=textbox[name=\"Number of bedrooms\"]",
      "action": "fill",
      "description": "Number of bedrooms (number field)"
    },
    "bathrooms": {
      "selector": "role=textbox[name=\"Number of bathrooms\"]",
      "action": "fill",
      "description": "Number of bathrooms (number field)"
    },
    "price": {
      "selector": "role=textbox[name=\"Price per month\"]",
      "action": "fill",
      "description": "Price per month (number field)"
    },
    "address": {
      "selector": "role=combobox[name=\"Rental address\"]",
      "action": "fill",
      "description": "Rental address (text with suggestions)"
    },
    "description": {
      "selector": "role=textbox[name=\"Rental description\"]",
      "action": "fill",
      "description": "Rental description (textarea)"
    },
    "next_1": {
      "selector": "role=button[name=\"Next\"]",
      "action": "click",
      "description": "'Next' button at the bottom of the rental form"
    },
    "publish": {
      "selector": "role=button[name=\"Publish\"]",
      "action": "submit",
      "description": "'Publish' button on the last step that makes the listing public (NEVER clicked)"
    }
  },
  "flow": [
    {
      "do": "upload",
      "el": "photos",
      "value": "photos",
      "required": true
    },
    {
      "do": "choose",
      "el": "home_type",
      "value": "home_type"
    },
    {
      "do": "fill",
      "el": "bedrooms",
      "value": "bedrooms"
    },
    {
      "do": "fill",
      "el": "bathrooms",
      "value": "bathrooms"
    },
    {
      "do": "fill",
      "el": "price",
      "value": "price",
      "required": true
    },
    {
      "do": "fill",
      "el": "address",
      "value": "address",
      "required": true
    },
    {
      "do": "fill",
      "el": "description",
      "value": "description",
      "required": true
    },
    {
      "do": "click",
      "el": "next_1",
      "wait_ms": 1500
    },
    {
      "do": "stop_before",
      "el": "publish"
    }
  ],
  "changelog": []
}
