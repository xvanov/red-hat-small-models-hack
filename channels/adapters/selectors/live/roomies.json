{
  "platform": "roomies",
  "target": "live",
  "verified": false,
  "notes": "UNVERIFIED best guess at the real site, written without logging in. Expect the first live run to hit PAGE_CHANGED on some elements; the repair loop (operator model) rewrites them against the real page and logs each change below. The final button is never clicked.",
  "start_url": "https://www.roomies.com/rooms/new",
  "login_url": "https://www.roomies.com/login",
  "login_wall": "form[action*=\"login\"] input[type=\"password\"]",
  "validation_error": ".error, [role=\"alert\"]",
  "elements": {
    "rent": {
      "selector": "role=spinbutton[name*=\"rent\" i], input[name*=\"rent\" i]",
      "action": "fill",
      "description": "Monthly rent (number field)"
    },
    "available_date": {
      "selector": "input[name*=\"available\" i]",
      "action": "fill",
      "description": "Available from (date field)"
    },
    "address": {
      "selector": "input[name*=\"address\" i]",
      "action": "fill",
      "description": "Street or neighborhood (text field)"
    },
    "headline": {
      "selector": "input[name*=\"title\" i]",
      "action": "fill",
      "description": "Listing headline (text field)"
    },
    "description": {
      "selector": "textarea",
      "action": "fill",
      "description": "Describe your place (textarea)"
    },
    "photos": {
      "selector": "input[type=\"file\"]",
      "action": "upload",
      "description": "Room photos (photo upload file input)"
    },
    "next": {
      "selector": "role=button[name=/next|continue/i]",
      "action": "click",
      "description": "'Next' or 'Continue' button that advances the listing form"
    },
    "publish": {
      "selector": "role=button[name=/publish|post|list/i]",
      "action": "submit",
      "description": "'Publish listing' button that makes the room public (NEVER clicked)"
    }
  },
  "flow": [
    {
      "do": "fill",
      "el": "rent",
      "value": "price",
      "required": true
    },
    {
      "do": "fill",
      "el": "available_date",
      "value": "available_date"
    },
    {
      "do": "fill",
      "el": "address",
      "value": "address",
      "required": true
    },
    {
      "do": "fill",
      "el": "headline",
      "value": "headline"
    },
    {
      "do": "fill",
      "el": "description",
      "value": "description",
      "required": true
    },
    {
      "do": "upload",
      "el": "photos",
      "value": "photos",
      "required": true
    },
    {
      "do": "click",
      "el": "next",
      "wait_ms": 1500,
      "if_present": true
    },
    {
      "do": "stop_before",
      "el": "publish"
    }
  ],
  "changelog": []
}
