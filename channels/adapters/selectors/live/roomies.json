{
  "platform": "roomies",
  "target": "live",
  "verified": false,
  "notes": "Start: the 'list a room' form on the owner's logged-in profile. Logged-out or bot-checked runs return LOGIN_REQUIRED with the login command.",
  "start_url": "https://www.roomies.com/rooms/new",
  "login_url": "https://www.roomies.com/login",
  "login_wall": "input[type=\"password\"], header a[href$=\"/login\"], a[href=\"https://www.roomies.com/login\"]",
  "validation_error": ".error, [role=\"alert\"]",
  "elements": {
    "rent": {
      "selector": "role=spinbutton[name*=\"rent\" i], input[name*=\"rent\" i]",
      "action": "fill",
      "description": "Monthly rent (number field)"
    },
    "available_date": {
      "selector": "input[name*=\"available\" i]",
      "action": "fill",
      "description": "Available from (date field)"
    },
    "address": {
      "selector": "input[name*=\"address\" i]",
      "action": "fill",
      "description": "Street or neighborhood (text field)"
    },
    "headline": {
      "selector": "input[name*=\"title\" i]",
      "action": "fill",
      "description": "Listing headline (text field)"
    },
    "description": {
      "selector": "textarea",
      "action": "fill",
      "description": "Describe your place (textarea)"
    },
    "photos": {
      "selector": "input[type=\"file\"]",
      "action": "upload",
      "description": "Room photos (photo upload file input)"
    },
    "next": {
      "selector": "role=button[name=/next|continue/i]",
      "action": "click",
      "description": "'Next' or 'Continue' button that advances the listing form"
    },
    "publish": {
      "selector": "role=button[name=/publish|post|list/i]",
      "action": "submit",
      "description": "'Publish listing' button that makes the room public (NEVER clicked)"
    }
  },
  "flow": [
    {
      "do": "fill",
      "el": "rent",
      "value": "price",
      "required": true
    },
    {
      "do": "fill",
      "el": "available_date",
      "value": "available_date"
    },
    {
      "do": "fill",
      "el": "address",
      "value": "address",
      "required": true
    },
    {
      "do": "fill",
      "el": "headline",
      "value": "headline"
    },
    {
      "do": "fill",
      "el": "description",
      "value": "description",
      "required": true
    },
    {
      "do": "upload",
      "el": "photos",
      "value": "photos",
      "required": true
    },
    {
      "do": "click",
      "el": "next",
      "wait_ms": 1500,
      "if_present": true
    },
    {
      "do": "stop_before",
      "el": "publish"
    }
  ],
  "changelog": [],
  "verified_note": "2026-10-18 03:55 ET, logged out: www.roomies.com loads; /rooms/new answers 404 to a logged-out browser and /login, /rooms, /signup answer Cloudflare's 'Just a moment...' check (403) to a fresh headless browser. The form fields below are unverified until the owner's profile is logged in; the repair loop fixes them on the first run.",
  "bot_wall_title": "just a moment|attention required|verify you are human",
  "expect_url_contains": "/rooms"
}
