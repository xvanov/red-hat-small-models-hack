{
  "platform": "craigslist",
  "target": "live",
  "verified": true,
  "verified_note": "2026-10-18 03:50 ET: type, category and the full posting-details form (field names, jQuery UI drop-downs, validation markup) observed on the real anonymous flow at post.craigslist.org/c/ral without logging in; nothing was continued past the details form. The location, images and preview steps after it follow craigslist's documented flow and are unverified until the owner's first logged-in run.",
  "notes": "Raleigh (ral) > housing offered > rooms & shares. Stops at the preview page before 'publish'. Without an account and no CHANNELS_CONTACT_EMAIL it stops after filling the details form (stop_if_empty on email).",
  "start_url": "https://post.craigslist.org/c/ral",
  "login_url": "https://accounts.craigslist.org/login",
  "login_wall": "form[name=\"login\"], input#inputEmailHandle",
  "validation_error": ".error-list .err, .error-list",
  "forbidden_click_url": "[?&]s=preview",
  "elements": {
    "type_housing": {
      "selector": "input[type=\"radio\"][name=\"id\"][value=\"ho\"]",
      "action": "check",
      "description": "'housing offered' posting type radio option"
    },
    "category_rooms": {
      "selector": "label.radio-option:has-text(\"rooms & shares\") input[type=\"radio\"]",
      "action": "check",
      "description": "'rooms & shares' housing category radio option"
    },
    "continue": {
      "selector": "button[name=\"go\"]:visible",
      "action": "click",
      "description": "'continue' button that advances to the next page of the posting flow"
    },
    "posting_title": {
      "selector": "input[name=\"PostingTitle\"]",
      "action": "fill",
      "description": "posting title (text field)"
    },
    "area": {
      "selector": "input[name=\"geographic_area\"]",
      "action": "fill",
      "description": "city or neighborhood (text field)"
    },
    "postal": {
      "selector": "input[name=\"postal\"]",
      "action": "fill",
      "description": "ZIP code (text field)"
    },
    "body": {
      "selector": "textarea[name=\"PostingBody\"]",
      "action": "fill",
      "description": "description (textarea)"
    },
    "price": {
      "selector": "input[name=\"price\"]",
      "action": "fill",
      "description": "rent / $ (number field)"
    },
    "rent_period": {
      "selector": "label.json-form-item.rent_period span[role=\"combobox\"]",
      "action": "choose",
      "description": "'per' drop-down: rent period (day/week/month)"
    },
    "private_room": {
      "selector": "label.json-form-item.private_room span[role=\"combobox\"]",
      "action": "choose",
      "description": "'private room' drop-down"
    },
    "housing_type": {
      "selector": "label.json-form-item.housing_type span[role=\"combobox\"]",
      "action": "choose",
      "description": "'housing type' drop-down (apartment, house, ...)"
    },
    "private_bath": {
      "selector": "label.json-form-item.private_bath span[role=\"combobox\"]",
      "action": "choose",
      "description": "'private bath' drop-down"
    },
    "laundry": {
      "selector": "label.json-form-item.laundry span[role=\"combobox\"]",
      "action": "choose",
      "description": "'laundry' drop-down"
    },
    "parking": {
      "selector": "label.json-form-item.parking span[role=\"combobox\"]",
      "action": "choose",
      "description": "'parking' drop-down"
    },
    "furnished": {
      "selector": "input[type=\"checkbox\"][name=\"is_furnished\"]",
      "action": "check",
      "description": "'furnished' checkbox"
    },
    "cats_ok": {
      "selector": "input[type=\"checkbox\"][name=\"pets_cat\"]",
      "action": "check",
      "description": "'cats ok' checkbox"
    },
    "available_date": {
      "selector": "input.movein_date.datepicker",
      "action": "fill",
      "description": "'available on' date field (YYYY-MM-DD)"
    },
    "email": {
      "selector": "input[name=\"FromEMail\"]",
      "action": "fill",
      "description": "contact email (text field, prefilled when logged in)"
    },
    "relay": {
      "selector": "input[type=\"radio\"][name=\"Privacy\"][value=\"C\"]",
      "action": "check",
      "description": "'use CL mail relay' email option radio"
    },
    "photos": {
      "selector": "input[type=\"file\"]",
      "action": "upload",
      "description": "add images (photo upload file input)"
    },
    "done_images": {
      "selector": "button.done:visible, button:has-text(\"done with images\"):visible",
      "action": "click",
      "description": "'done with images' button"
    },
    "publish": {
      "selector": "button[name=\"go\"]:visible",
      "action": "submit",
      "description": "'publish' button on the preview page (NEVER clicked)"
    }
  },
  "flow": [
    {
      "do": "check",
      "el": "type_housing",
      "url_contains": "s=type"
    },
    {
      "do": "click",
      "el": "continue",
      "wait_ms": 800,
      "url_contains": "s=type"
    },
    {
      "do": "check",
      "el": "category_rooms",
      "url_contains": "s=hcat"
    },
    {
      "do": "click",
      "el": "continue",
      "wait_ms": 800,
      "url_contains": "s=hcat"
    },
    {
      "do": "fill",
      "el": "posting_title",
      "value": "posting_title",
      "required": true
    },
    {
      "do": "fill",
      "el": "area",
      "value": "area"
    },
    {
      "do": "fill",
      "el": "postal",
      "value": "postal",
      "required": true
    },
    {
      "do": "fill",
      "el": "body",
      "value": "body",
      "required": true
    },
    {
      "do": "fill",
      "el": "price",
      "value": "price",
      "required": true
    },
    {
      "do": "choose",
      "el": "rent_period",
      "value": "rent_period_text",
      "exact": true
    },
    {
      "do": "choose",
      "el": "private_room",
      "value": "private_room_text",
      "exact": true
    },
    {
      "do": "choose",
      "el": "housing_type",
      "value": "housing_type_text",
      "exact": true
    },
    {
      "do": "choose",
      "el": "private_bath",
      "value": "private_bath_text",
      "exact": true
    },
    {
      "do": "choose",
      "el": "laundry",
      "value": "laundry_text",
      "exact": true
    },
    {
      "do": "choose",
      "el": "parking",
      "value": "parking_text",
      "exact": true
    },
    {
      "do": "check",
      "el": "furnished",
      "value": "furnished"
    },
    {
      "do": "check",
      "el": "cats_ok",
      "value": "cat_friendly"
    },
    {
      "do": "fill",
      "el": "available_date",
      "value": "available_date",
      "press": "Tab"
    },
    {
      "do": "stop_if_empty",
      "el": "email",
      "value": "email",
      "stage": "details_form_filled",
      "needs": "a craigslist login (email prefilled) or CHANNELS_CONTACT_EMAIL to continue past the details form"
    },
    {
      "do": "fill_if_empty",
      "el": "email",
      "value": "email"
    },
    {
      "do": "check",
      "el": "relay"
    },
    {
      "do": "click",
      "el": "continue",
      "wait_ms": 2000,
      "url_contains": "s=edit"
    },
    {
      "do": "click",
      "el": "continue",
      "wait_ms": 2000,
      "url_contains": "s=geoverify"
    },
    {
      "do": "upload",
      "el": "photos",
      "value": "photos",
      "required": true,
      "url_contains": "s=editimage"
    },
    {
      "do": "click",
      "el": "done_images",
      "wait_ms": 2500,
      "url_contains": "s=editimage"
    },
    {
      "do": "stop_before",
      "el": "publish"
    }
  ],
  "changelog": []
}
