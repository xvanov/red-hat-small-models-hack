{
  "platform": "craigslist",
  "target": "live",
  "verified": false,
  "notes": "UNVERIFIED best guess at the real site, written without logging in. Expect the first live run to hit PAGE_CHANGED on some elements; the repair loop (operator model) rewrites them against the real page and logs each change below. The final button is never clicked.",
  "start_url": "https://post.craigslist.org/c/rdu",
  "login_url": "https://accounts.craigslist.org/login",
  "login_wall": "form[name=\"login\"], input#inputEmailHandle",
  "validation_error": ".error, .validation-error",
  "elements": {
    "type_housing": {
      "selector": "label:has-text(\"housing offered\") input[type=\"radio\"]",
      "action": "check",
      "description": "'housing offered' posting type radio option"
    },
    "category_rooms": {
      "selector": "label:has-text(\"rooms & shares\") input[type=\"radio\"]",
      "action": "check",
      "description": "'rooms & shares' category radio option"
    },
    "continue": {
      "selector": "button[name=\"go\"]",
      "action": "click",
      "description": "'continue' button that advances to the next page of the posting flow"
    },
    "posting_title": {
      "selector": "input[name=\"PostingTitle\"]",
      "action": "fill",
      "description": "posting title (text field)"
    },
    "price": {
      "selector": "input[name=\"price\"]",
      "action": "fill",
      "description": "price (number field)"
    },
    "area": {
      "selector": "input[name=\"geographic_area\"]",
      "action": "fill",
      "description": "city or neighborhood (text field)"
    },
    "postal": {
      "selector": "input[name=\"postal\"]",
      "action": "fill",
      "description": "ZIP code (text field)"
    },
    "body": {
      "selector": "textarea[name=\"PostingBody\"]",
      "action": "fill",
      "description": "description (textarea)"
    },
    "email": {
      "selector": "input[name=\"FromEMail\"]",
      "action": "fill",
      "description": "your email address (text field, prefilled when logged in)"
    },
    "photos": {
      "selector": "input[type=\"file\"]",
      "action": "upload",
      "description": "add images (photo upload file input)"
    },
    "done_images": {
      "selector": "button.done, button:has-text(\"done with images\")",
      "action": "click",
      "description": "'done with images' button"
    },
    "publish": {
      "selector": "button[name=\"go\"][value=\"Continue\"], button:has-text(\"publish\")",
      "action": "submit",
      "description": "'publish' button on the preview page (NEVER clicked)"
    }
  },
  "flow": [
    {
      "do": "check",
      "el": "type_housing"
    },
    {
      "do": "click",
      "el": "continue",
      "wait_ms": 1500,
      "if_present": true
    },
    {
      "do": "check",
      "el": "category_rooms"
    },
    {
      "do": "click",
      "el": "continue",
      "wait_ms": 1500,
      "if_present": true
    },
    {
      "do": "fill",
      "el": "posting_title",
      "value": "posting_title",
      "required": true
    },
    {
      "do": "fill",
      "el": "price",
      "value": "price",
      "required": true
    },
    {
      "do": "fill",
      "el": "area",
      "value": "area"
    },
    {
      "do": "fill",
      "el": "postal",
      "value": "postal",
      "required": true
    },
    {
      "do": "fill",
      "el": "body",
      "value": "body",
      "required": true
    },
    {
      "do": "fill_if_empty",
      "el": "email",
      "value": "email",
      "if_present": true
    },
    {
      "do": "click",
      "el": "continue",
      "wait_ms": 2000
    },
    {
      "do": "click",
      "el": "continue",
      "wait_ms": 2000,
      "if_present": true
    },
    {
      "do": "upload",
      "el": "photos",
      "value": "photos",
      "required": true
    },
    {
      "do": "click",
      "el": "done_images",
      "wait_ms": 2000
    },
    {
      "do": "stop_before",
      "el": "publish"
    }
  ],
  "changelog": []
}
