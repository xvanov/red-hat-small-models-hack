{
  "platform": "padsplit",
  "target": "live",
  "verified": false,
  "notes": "PadSplit host portal, add a room. Weekly price = monthly x 12 / 52. Final 'Submit for review' is never clicked.",
  "start_url": "https://www.padsplit.com/host",
  "login_url": "https://www.padsplit.com/login",
  "login_wall": "input[type=\"password\"][name=\"password\"], button:has-text(\"Sign in\")",
  "validation_error": "[role=\"alert\"]",
  "elements": {
    "address": {
      "selector": "input[name*=\"address\" i]",
      "action": "fill",
      "description": "Property address (text field)"
    },
    "weekly_price": {
      "selector": "input[name*=\"price\" i]",
      "action": "fill",
      "description": "Weekly price (number field)"
    },
    "available_date": {
      "selector": "input[type=\"date\"]",
      "action": "fill",
      "description": "Available date (date field)"
    },
    "description": {
      "selector": "textarea",
      "action": "fill",
      "description": "Room description (textarea)"
    },
    "photos": {
      "selector": "input[type=\"file\"]",
      "action": "upload",
      "description": "Upload photos (photo upload file input)"
    },
    "next": {
      "selector": "role=button[name=/next|continue/i]",
      "action": "click",
      "description": "'Next' button that advances the add-room form"
    },
    "publish": {
      "selector": "role=button[name=/submit|review|publish/i]",
      "action": "submit",
      "description": "'Submit for review' button (NEVER clicked)"
    }
  },
  "flow": [
    {
      "do": "fill",
      "el": "address",
      "value": "address",
      "required": true
    },
    {
      "do": "fill",
      "el": "weekly_price",
      "value": "weekly_price",
      "required": true
    },
    {
      "do": "fill",
      "el": "available_date",
      "value": "available_date"
    },
    {
      "do": "fill",
      "el": "description",
      "value": "description",
      "required": true
    },
    {
      "do": "upload",
      "el": "photos",
      "value": "photos",
      "required": true
    },
    {
      "do": "click",
      "el": "next",
      "wait_ms": 1500,
      "if_present": true
    },
    {
      "do": "stop_before",
      "el": "publish"
    }
  ],
  "changelog": [],
  "verified_note": "2026-10-18 03:55 ET, logged out: padsplit.com/host and /host/* redirect to the home page with the email + password sign-in form (detected as the login wall). Host-side add-room fields below are unverified until the owner's host profile is logged in.",
  "bot_wall_title": "just a moment|attention required",
  "expect_url_contains": "/host"
}
