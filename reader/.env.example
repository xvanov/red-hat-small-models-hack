# Reader endpoint (second vLLM process on the Brev GPU, tunnelled to localhost:8001). See reader/serve.md.
READER_BASE_URL=http://localhost:8001/v1
READER_MODEL=rentus-reader
# same value as OPERATOR_API_KEY (the reader container reuses ~/serving/vllm.env)
READER_API_KEY=
# only for reader/publish.py --push, after the owner approves
HF_TOKEN=
