# Operator model (W1 serving): vLLM on Brev, reached through serving/tunnel.sh
OPERATOR_BASE_URL=http://localhost:8000/v1
OPERATOR_MODEL=nemotron-3.5-lightning
OPERATOR_API_KEY=   # set in .env (generated by W1; never commit)

# Reader: fine-tuned Qwen3-0.6B served by a second vLLM container (instance port 8001),
# tunneled with: LPORT=8011 RPORT=8001 serving/tunnel.sh
READER_BASE_URL=http://localhost:8011/v1
READER_MODEL=rentus-reader
READER_API_KEY=${OPERATOR_API_KEY}
